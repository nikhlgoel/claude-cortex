# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Backups & Staging
*.bak
*.swp
*~
staged_user_data_*/
.claude-backups/

# Local credentials & runtime states
.credentials.json
*.key
.env
providers.json.local
models_cache.json
history.jsonl
projects/
file-history/

# Per-machine Claude Code permissions, and reports the test runner regenerates
.claude/settings.local.json
tests/METRICS_REPORT.*

# Release archives are build output: scripts/build-releases.py makes them and they are uploaded to
# GitHub Releases. They never belong in a commit (each one is a few hundred KB of binary diff).
releases/
dist/
*.tmp
*.log

# Scratch and one-off files
/a.exe
/claude_decompiletest.exe
/fix_batch_*.py
/PLAN.md
/TASKS.md

# Written by tools/ghidra/update_watch.py on every run (cortex/integrity.py already excludes them)
tools/ghidra/watch-state.json
tools/ghidra/baseline-current.json

# Other Python and tooling output
*.egg-info/
.pytest_cache/
.mypy_cache/
.venv/
venv/
build/
.coverage
htmlcov/

# Editor folders
.idea/
.vscode/

# OS metadata
.DS_Store
Thumbs.db
*.pyc

# local Ghidra verification artifacts
.ghidra-test/
ghidra-out/

# integrity manifest - generated at install/release, never committed (would go stale)
MANIFEST.sha256
