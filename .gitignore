# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Backups & Staging
*.bak
*.swp
*~
staged_user_data_*/
.claude-backups/

# Local credentials & runtime states
.credentials.json
*.key
.env
providers.json.local
models_cache.json
history.jsonl
projects/
file-history/

# Per-machine Claude Code permissions, and reports the test runner regenerates
.claude/settings.local.json
tests/METRICS_REPORT.*

# Distribution archives (tracked in releases/ or built dynamically)
dist/
*.tmp
*.log

# OS metadata
.DS_Store
Thumbs.db
*.pyc

# local Ghidra verification artifacts
.ghidra-test/
ghidra-out/

# integrity manifest - generated at install/release, never committed (would go stale)
MANIFEST.sha256
