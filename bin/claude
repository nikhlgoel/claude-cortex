#!/usr/bin/env bash
# ==============================================================================
# Claude Cortex - bash shim
#
# All logic lives in the Python core (cortex/). This file only locates it and
# hands over. Keeping the shells this thin is deliberate: the previous 1223-line
# bash wrapper and 565-line PowerShell wrapper had drifted into two different
# products, and most platform bugs came from that gap.
# ==============================================================================

set -euo pipefail

# Locate the Cortex package: installed copy first, then alongside this script
# (running straight from a checkout).
CORTEX_HOME="${CORTEX_HOME:-}"
if [ -z "$CORTEX_HOME" ]; then
    for candidate in \
        "${HOME}/.claude/cortex-core" \
        "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." 2>/dev/null && pwd)"; do
        if [ -n "$candidate" ] && [ -d "${candidate}/cortex" ]; then
            CORTEX_HOME="$candidate"
            break
        fi
    done
fi

if [ -z "$CORTEX_HOME" ] || [ ! -d "${CORTEX_HOME}/cortex" ]; then
    echo "cc: Cortex core not found. Reinstall with: bash install.sh" >&2
    exit 1
fi

PYTHON="${CORTEX_PYTHON:-}"
if [ -z "$PYTHON" ]; then
    for candidate in python3 python; do
        if command -v "$candidate" >/dev/null 2>&1; then
            PYTHON="$candidate"
            break
        fi
    done
fi

if [ -z "$PYTHON" ]; then
    echo "cc: Python 3 is required but was not found on PATH." >&2
    exit 1
fi

export PYTHONPATH="${CORTEX_HOME}${PYTHONPATH:+:${PYTHONPATH}}"
exec "$PYTHON" -m cortex "$@"
